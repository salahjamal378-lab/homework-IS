def rc4_key_schedule(key):
    S = list(range(256))
    j = 0
    for i in range(256):
        j = (j + S[i] + key[i % len(key)]) % 256
        S[i], S[j] = S[j], S[i]
    return S

def rc4_keystream(S, length):
    i = j = 0
    keystream = []
    for _ in range(length):
        i = (i + 1) % 256
        j = (j + S[i]) % 256
        S[i], S[j] = S[j], S[i]
        K = S[(S[i] + S[j]) % 256]
        keystream.append(K)
    return keystream

def binary_derivative_test(sequence):
    deriv = []
    for i in range(len(sequence)-1):
        deriv.append(sequence[i] ^ sequence[i+1])
    return deriv

def change_point_test(original_key, modified_key):
    original_keystream = rc4_keystream(rc4_key_schedule(original_key), 1000)
    modified_keystream = rc4_keystream(rc4_key_schedule(modified_key), 1000)
    changes = sum(a != b for a, b in zip(original_keystream, modified_keystream))
    return changes / len(original_keystream)

def encrypt(text, key):
  result = ""

  for ch in text:
    if 'a' <= ch <= 'z':
      x = ord(ch) - ord('a')
      x = (x * key) % 26
      result += chr(x + ord('a'))
    else:
      result += ch

  return result


def inverse(key):
  for i in range(26):
    if (key * i) % 26 == 1:
      return i


def decrypt(text, key):
  inv = inverse(key)
  result = ""

  for ch in text:
    if 'a' <= ch <= 'z':
      x = ord(ch) - ord('a')
      x = (x * inv) % 26
      result += chr(x + ord('a'))
    else:
      result += ch

  return result


def blind_attack(cipher_text):
  for key in range(1, 26):
    if inverse(key) is not None:
      print("key =", key, "->", decrypt(cipher_text, key))
